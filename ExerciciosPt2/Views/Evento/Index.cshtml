@using ExerciciosPt2.Controllers
@model List<Evento>
@{
    ViewData["Title"] = "Listagem de Alunos";
}

<h1>Listagem geral de Alunos</h1>

<table>
    <tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Descrição</th>
        <th>Local</th>
        <th>Data evento</th>
        <th>Quantidade vagas</th>
        <th>Valor ingresso</th>
    </tr>

    @foreach (Evento evento in Model)
        {
        <tr>
            <td>@evento.Id</td>
            <td>@evento.Nome</td>
            <td>@evento.Descricao</td>
            <td>@evento.Local</td>
            <td>@evento.DataEvento</td>
            <td>@evento.QuantidadeVagas</td>
            <td>@evento.ValorIngresso</td>
            <td>
                <a asp-action="Detalhes" asp-route-id="@evento.Id">Ver</a>
            </td>
        </tr>
    }
</table>